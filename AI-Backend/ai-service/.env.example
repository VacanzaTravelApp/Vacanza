# OpenAI (required for AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database (required)
# Local: postgresql://vacanza:vacanza@localhost:5432/vacanza_ai
# Server: postgresql://user:password@host:port/database
DATABASE_URL=

# Optional — used when DATABASE_URL is not set
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=vacanza_ai
# DB_USER=vacanza
# DB_PASSWORD=vacanza

# Server (optional)
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
